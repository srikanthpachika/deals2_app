# Copy to .env (recommended for Prisma CLI) or .env.local
# .env.example
# Local dev / Production (Postgres)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
ADMIN_TOKEN="password12"
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-xxxxxxxxxxxxxxxx"
DEAL_TTL_HOURS="24"
AUTO_INGEST_ON_REQUEST="true"
AUTO_INGEST_STALE_MINUTES="10"
AUTO_INGEST_COOLDOWN_MINUTES="3"
AUTO_INGEST_MAX_PER_RUN="50"
AUTO_INGEST_MAX_PER_SOURCE="50"
AUTO_INGEST_MAX_SCRAPE="15"
AUTO_INGEST_MAX_RESOLVE="15"
INGEST_DAILY_LIMIT="1500"
INGEST_MAX_PER_RUN="300"
INGEST_MAX_PER_SOURCE="120"
INGEST_MAX_SCRAPE="40"
INGEST_MAX_RESOLVE="40"
INGEST_MIN_SCORE="3"
INGEST_MIN_PERCENT="15"
INGEST_INTERVAL_MINUTES="10"
