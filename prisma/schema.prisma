// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Deal {
  id          Int      @id @default(autoincrement())
  title       String
  url         String   @unique
  source      String?
  price       String?
  percentOff  Int?
  percentVerified Boolean @default(false)
  image       String?
  description String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  approved    Boolean  @default(false)
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

model PercentModel {
  id        Int      @id @default(autoincrement())
  weights   Json
  bias      Float    @default(0)
  samples   Int      @default(0)
  updatedAt DateTime @updatedAt
}
